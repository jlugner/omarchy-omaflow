#!/bin/bash

# Execute one rule's actions deterministically.
#
#   omaflow-run <rule-id> [--dry-run] [--trigger "<description>"]
#   omaflow-run --revert <execution-id>
#
# Revertible action types (theme, dnd, nightlight, stay-awake, audio-output)
# get a pre-execution snapshot; --revert restores it. On a failed action the
# remaining actions are skipped and applied revertibles are rolled back.

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/omaflow-lib.sh"
omaflow_init_dirs

dry_run=false
trigger_desc="manual"
revert_id=""
rule_id=""

while (( $# > 0 )); do
  case "$1" in
  --dry-run) dry_run=true; shift ;;
  --trigger) trigger_desc="${2:?}"; shift 2 ;;
  --revert) revert_id="${2:?}"; shift 2 ;;
  -*) echo "Unknown option: $1" >&2; exit 2 ;;
  *) rule_id="$1"; shift ;;
  esac
done

now() { date --iso-8601=seconds; }
run_cmd() { timeout 30 "$@"; }

# Runs, reverts, and their state writes are serialized: concurrent executions
# would interleave desktop changes and restore each other's snapshots.
exec 8>"$OMAFLOW_STATE_DIR/.run.lock"
flock -w 90 8 || { echo "Another Omaflow run is holding the lock" >&2; exit 1; }

# ---- revert -------------------------------------------------------------------
if [[ -n $revert_id ]]; then
  [[ $revert_id =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,40}$ ]] || { echo "Invalid execution id" >&2; exit 2; }
  snapshot_file="$OMAFLOW_SNAPSHOTS_DIR/$revert_id.json"
  [[ -f $snapshot_file ]] || { echo "No snapshot for execution: $revert_id" >&2; exit 1; }
  snap=$(jq -c 'select(type == "object")' "$snapshot_file" 2>/dev/null || true)
  [[ -n $snap ]] || { echo "Snapshot is not valid JSON: $snapshot_file" >&2; exit 1; }
  revert_failures=0
  restore() { # key, command...
    local value
    value=$(jq -r --arg k "$1" '.[$k] // ""' <<<"$snap")
    [[ -n $value ]] || return 0
    shift
    run_cmd "$@" "$value" >/dev/null 2>&1 || { echo "revert failed for: $*" >&2; ((revert_failures += 1)); }
  }
  restore theme omarchy theme set
  restore dnd omarchy-shell notifications setDnd
  restore defaultSink pactl set-default-sink
  nl=$(jq -r '.nightlight // ""' <<<"$snap")
  if [[ $nl == on || $nl == off ]]; then
    subcmd=enable; [[ $nl == off ]] && subcmd=disable
    run_cmd omarchy-shell nightlight "$subcmd" >/dev/null 2>&1 || ((revert_failures += 1))
  fi
  sa=$(jq -r '.stayAwake // ""' <<<"$snap")
  if [[ $sa == "true" || $sa == "false" ]]; then
    subcmd=enable; [[ $sa == "true" ]] && subcmd=disable
    run_cmd omarchy-shell idle "$subcmd" >/dev/null 2>&1 || ((revert_failures += 1))
  fi
  revert_status=ok
  (( revert_failures > 0 )) && revert_status=partial
  omaflow_log_append "$(jq -cn --arg at "$(now)" --arg execId "$revert_id" --arg status "$revert_status" \
    '{at: $at, kind: "revert", execId: $execId, status: $status}')"
  omaflow_notify "Omaflow" "Reverted execution $revert_id ($revert_status)"
  [[ $revert_status == ok ]]
  exit
fi

# ---- run ----------------------------------------------------------------------
[[ -n $rule_id ]] || { echo "Usage: omaflow-run <rule-id> [--dry-run] [--trigger d] | --revert <exec-id>" >&2; exit 2; }
rule_file=$(omaflow_rule_file "$rule_id") || { echo "Invalid rule id" >&2; exit 2; }
[[ -f $rule_file ]] || { echo "No such rule: $rule_id" >&2; exit 1; }
rule=$(cat "$rule_file")
exec_id="$(date +%Y%m%d-%H%M%S)-$$"

if ! validation=$("$(dirname "${BASH_SOURCE[0]}")/omaflow-validate" "$rule_file" 2>&1); then
  omaflow_log_append "$(jq -cn --arg at "$(now)" --arg ruleId "$rule_id" --arg execId "$exec_id" \
    --arg detail "$validation" \
    '{at: $at, kind: "run", execId: $execId, ruleId: $ruleId, status: "invalid", detail: $detail}')"
  echo "Rule failed validation:" >&2
  echo "$validation" >&2
  exit 1
fi

# Snapshot current state for the revertible action types this rule uses.
# Fail closed: if a needed snapshot cannot be captured, the rule does not run —
# otherwise a later failure could not be rolled back.
snapshot="{}"
has_action() { jq -e --arg t "$1" '[.actions[].type] | index($t) != null' >/dev/null <<<"$rule"; }
snapshot_failed=""
if ! $dry_run; then
  snap_add() { # key value
    if [[ -z ${2//[[:space:]]/} ]]; then
      snapshot_failed="$1"
      return 0
    fi
    snapshot=$(jq -c --arg k "$1" --arg v "$2" '.[$k] = $v' <<<"$snapshot")
  }
  has_action theme && snap_add theme "$(run_cmd omarchy theme current 2>/dev/null || true)"
  has_action dnd && snap_add dnd "$(run_cmd omarchy-shell notifications dndState 2>/dev/null || true)"
  if has_action nightlight; then
    nl_enabled=$(run_cmd omarchy-shell nightlight status 2>/dev/null | jq -r 'if type == "object" then (if .enabled then "on" else "off" end) elif . == "on" or . == "off" then . else "" end' 2>/dev/null || true)
    snap_add nightlight "$nl_enabled"
  fi
  has_action stay-awake && snap_add stayAwake "$(run_cmd omarchy-shell idle status 2>/dev/null | jq -r '.stayAwake | if type == "boolean" then tostring else "" end' 2>/dev/null || true)"
  has_action audio-output && snap_add defaultSink "$(run_cmd pactl get-default-sink 2>/dev/null || true)"
  if [[ -n $snapshot_failed ]]; then
    omaflow_log_append "$(jq -cn --arg at "$(now)" --arg execId "$exec_id" --arg ruleId "$rule_id" --arg field "$snapshot_failed" \
      '{at: $at, kind: "run", execId: $execId, ruleId: $ruleId, status: "snapshot-failed", detail: ("could not capture current " + $field)}')"
    omaflow_notify "Omaflow rule skipped" "Could not snapshot current $snapshot_failed for rollback"
    exit 1
  fi
  printf '%s\n' "$snapshot" >"$OMAFLOW_SNAPSHOTS_DIR/$exec_id.json"
  find "$OMAFLOW_SNAPSHOTS_DIR" -name '*.json' -mtime +14 -delete 2>/dev/null || true
fi

resolve_desktop() { # app name -> desktop id (basename without .desktop)
  local app="$1" dir match app_re app_glob
  app_re=$(sed 's/[.[\*^$()+?{|]/\\&/g' <<<"$app")
  app_glob=$(sed 's/[][*?\\]/\\&/g' <<<"$app")
  for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" /usr/share/applications /usr/local/share/applications; do
    [[ -d $dir ]] || continue
    match=$(grep -rilE -- "^Name=${app_re}\$" "$dir"/*.desktop 2>/dev/null | head -1 || true)
    [[ -z $match && -f "$dir/$app.desktop" ]] && match="$dir/$app.desktop"
    [[ -z $match ]] && match=$(find "$dir" -maxdepth 1 -iname "*$app_glob*.desktop" 2>/dev/null | head -1 || true)
    [[ -n $match ]] && { basename "$match" .desktop; return 0; }
  done
  return 1
}

apply_action() { # JSON action -> 0/1, sets $detail
  local action="$1" atype state
  atype=$(jq -r '.type' <<<"$action")
  detail=""
  case "$atype" in
  theme)
    detail=$(jq -r '.name' <<<"$action")
    run_cmd omarchy theme set "$detail" >/dev/null 2>&1
    ;;
  dnd)
    state=$(jq -r '.state' <<<"$action"); detail=$state
    run_cmd omarchy-shell notifications setDnd "$state" >/dev/null 2>&1
    ;;
  nightlight)
    state=$(jq -r '.state' <<<"$action"); detail=$state
    if [[ $state == on ]]; then run_cmd omarchy-shell nightlight enable >/dev/null 2>&1
    else run_cmd omarchy-shell nightlight disable >/dev/null 2>&1; fi
    ;;
  stay-awake)
    state=$(jq -r '.state' <<<"$action"); detail=$state
    if [[ $state == on ]]; then run_cmd omarchy-shell idle disable >/dev/null 2>&1
    else run_cmd omarchy-shell idle enable >/dev/null 2>&1; fi
    ;;
  launch)
    local app workspace desktop_id
    app=$(jq -r '.app' <<<"$action")
    workspace=$(jq -r '.workspace // ""' <<<"$action")
    desktop_id=$(resolve_desktop "$app") || { detail="no desktop entry: $app"; return 1; }
    detail="$desktop_id"
    [[ -n $workspace ]] && run_cmd hyprctl dispatch workspace "$workspace" >/dev/null 2>&1
    setsid gtk-launch "$desktop_id" >/dev/null 2>&1 &
    ;;
  workspace)
    detail=$(jq -r '.number' <<<"$action")
    run_cmd hyprctl dispatch workspace "$detail" >/dev/null 2>&1
    ;;
  audio-output)
    local sink_match sink
    sink_match=$(jq -r '.match' <<<"$action")
    sink=$(run_cmd pactl --format=json list sinks 2>/dev/null |
      jq -r --arg m "$sink_match" '[.[] | select((.description + " " + .name) | ascii_downcase | contains($m | ascii_downcase))][0].name // ""')
    [[ -n $sink ]] || { detail="no sink matches: $sink_match"; return 1; }
    detail="$sink"
    run_cmd pactl set-default-sink "$sink" >/dev/null 2>&1
    ;;
  grok-message)
    # Message a persistent, named Grok bot session. The send runs tool-less
    # (--tools ""), so the bot can never act on this machine — it only
    # receives the message and updates its own conversation state.
    local bot msg bots sid reply
    command -v grok >/dev/null || { detail="grok CLI is not installed"; return 1; }
    bot=$(jq -r '.bot' <<<"$action")
    msg=$(jq -r '.message' <<<"$action")
    msg=${msg//'{{trigger}}'/$trigger_desc}
    bots=$(jq -c 'select(type == "object")' "$OMAFLOW_BOTS_FILE" 2>/dev/null || echo '{}')
    sid=$(jq -r --arg b "$bot" '.[$b].sessionId // ""' <<<"$bots")
    if [[ -z $sid ]]; then
      sid=$(uuidgen)
      reply=$(timeout 120 grok -p "$msg" -s "$sid" --tools "" --disable-web-search --output-format plain 2>/dev/null) ||
        { detail="grok send failed creating bot: $bot"; return 1; }
      omaflow_write_json "$OMAFLOW_BOTS_FILE" "$(jq -c --arg b "$bot" --arg s "$sid" --arg at "$(now)" \
        '.[$b] = {sessionId: $s, createdAt: $at}' <<<"$bots")"
    else
      reply=$(timeout 120 grok -p "$msg" --resume "$sid" --tools "" --disable-web-search --output-format plain 2>/dev/null) ||
        { detail="grok send failed for bot: $bot"; return 1; }
    fi
    detail="$bot ← $(head -c 120 <<<"$reply" | tr -d '\n')"
    ;;
  notify)
    # The validator already rejects option-shaped fields; strip leading dashes
    # and control characters again here so notify-send can never parse a rule
    # value as an option (defense in depth against e.g. exec hints).
    local title
    detail=$(jq -r '.message' <<<"$action" | tr -d '[:cntrl:]' | sed 's/^-*//')
    title=$(jq -r '.title // "Omaflow"' <<<"$action" | tr -d '[:cntrl:]' | sed 's/^-*//')
    omaflow_notify "${title:-Omaflow}" "${detail:-·}"
    ;;
  *)
    detail="unknown action type: $atype"
    return 1
    ;;
  esac
}

results="[]"
status="ok"
while IFS= read -r action; do
  atype=$(jq -r '.type' <<<"$action")
  if $dry_run; then
    results=$(jq -c --arg t "$atype" --argjson a "$action" '. + [{type: $t, plan: $a, ok: true}]' <<<"$results")
    continue
  fi
  if apply_action "$action"; then
    results=$(jq -c --arg t "$atype" --arg d "$detail" '. + [{type: $t, detail: $d, ok: true}]' <<<"$results")
  else
    results=$(jq -c --arg t "$atype" --arg d "$detail" '. + [{type: $t, detail: $d, ok: false}]' <<<"$results")
    status="failed"
    break
  fi
done < <(jq -c '.actions[]' <<<"$rule")

if [[ $status == failed ]]; then
  # Roll back the revertible actions that were applied. Launch/workspace
  # actions are not revertible, so the run stays labelled "failed" — the
  # revert gets its own log entry with its own outcome.
  flock -u 8
  if "$0" --revert "$exec_id" >/dev/null 2>&1; then
    omaflow_notify "Omaflow rule failed" "$(jq -r '.name' <<<"$rule") — revertible changes rolled back"
  else
    omaflow_notify "Omaflow rule failed" "$(jq -r '.name' <<<"$rule") — rollback incomplete, see omaflow log"
  fi
  exec 8>"$OMAFLOW_STATE_DIR/.run.lock"
  flock -w 90 8 || true
fi

kind="run"; $dry_run && kind="dry-run"
omaflow_log_append "$(jq -cn \
  --arg at "$(now)" --arg kind "$kind" --arg execId "$exec_id" --arg ruleId "$rule_id" \
  --arg ruleName "$(jq -r '.name' <<<"$rule")" --arg trigger "$trigger_desc" --arg status "$status" \
  --argjson actions "$results" \
  '{at: $at, kind: $kind, execId: $execId, ruleId: $ruleId, ruleName: $ruleName, trigger: $trigger, status: $status, actions: $actions}')"

if ! $dry_run; then
  cooldowns=$(jq -c 'select(type == "object")' "$OMAFLOW_COOLDOWNS_FILE" 2>/dev/null || echo "{}")
  omaflow_write_json "$OMAFLOW_COOLDOWNS_FILE" "$(jq -c --arg id "$rule_id" --arg at "$(now)" \
    --argjson epoch "$(date +%s)" \
    '.[$id] = {lastFiredAt: $at, lastFiredEpoch: $epoch}' <<<"$cooldowns")"
  omaflow_reindex || true
fi

$dry_run && jq -r '.[] | "would run: \(.type) \(.plan | del(.type) | tojson)"' <<<"$results"
[[ $status == ok ]] || exit 1
